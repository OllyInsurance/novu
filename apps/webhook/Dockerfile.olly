# Olly build of the community `webhook` service.
#
# Why this exists: Novu ships the provider delivery-webhook receiver as a
# standalone service (apps/webhook), but stopped publishing its image per
# release. ghcr.io has webhook:2.0.0 and webhook:latest (3.14.0) only, while our
# stack runs 3.17.0. This builds that same community app at our exact version so
# Resend delivery events (delivered / bounced / complained) land on the Novu
# message record instead of being dropped.
#
# Upstream's Dockerfile consumes a pruned context produced by
# scripts/pnpm-context.mjs. That script needs a fully installed workspace root to
# run, which is a chicken-and-egg problem outside their CI. This variant takes
# the whole repo as context and lets pnpm prune the dependency graph instead,
# via --filter "{apps/webhook}...". Same output, fewer moving parts.
#
# Build (from the repo root):
#   docker build -f apps/webhook/Dockerfile.olly -t olly-novu-webhook:3.17.0 .

FROM node:22.22.1-alpine3.22 AS build
RUN apk add --no-cache g++ make py3-pip
ENV NX_DAEMON=false
RUN npm --no-update-notifier --no-fund --global install pnpm@11.0.9

WORKDIR /usr/src/app
COPY . .

# Install only the webhook app's dependency closure, not the whole monorepo.
RUN pnpm install --filter "novuhq" --filter "{apps/webhook}..." \
      --frozen-lockfile --unsafe-perm --reporter=silent

RUN NODE_ENV=production pnpm build:webhook

# Upstream copies these next to the built output; main.js reads them at boot.
WORKDIR /usr/src/app/apps/webhook
RUN cp src/dotenvcreate.mjs dist/dotenvcreate.mjs \
 && cp src/.example.env dist/.env \
 && cp src/.env.development dist/.env.development \
 && cp src/.env.production dist/.env.production

WORKDIR /usr/src/app
RUN pnpm --filter @novu/webhook deploy --legacy --prod /usr/src/deploy

# ---------- runtime ----------
FROM node:22.22.1-alpine3.22 AS prod
ENV CI=true
RUN npm --no-update-notifier --no-fund --global install pm2@6.0.14 \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

USER 1000
WORKDIR /usr/src/app
COPY --chown=1000:1000 --from=build /usr/src/deploy .
COPY --chown=1000:1000 --from=build /usr/src/app/apps/webhook/dist ./dist

ENTRYPOINT [ "sh", "-c", "node dist/dotenvcreate.mjs -s=$SECRET_NAME -r=$NOVU_REGION -e=$NOVU_ENTERPRISE -v=$NODE_ENV && pm2-runtime start dist/main.js -i max" ]
