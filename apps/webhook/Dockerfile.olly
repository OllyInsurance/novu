# Olly build of the community `webhook` service.
#
# Why this exists: Novu ships the provider delivery-webhook receiver as a
# standalone service (apps/webhook), but stopped publishing its image per
# release. ghcr.io has webhook:2.0.0 and webhook:latest (3.14.0) only, while our
# stack runs 3.17.0. This builds that same community app at our exact version so
# Resend delivery events (delivered / bounced / complained) land on the Novu
# message record instead of being dropped.
#
# Upstream's Dockerfile consumes a pruned context produced by
# scripts/pnpm-context.mjs. That script needs a fully installed workspace root to
# run, which is a chicken-and-egg problem outside their CI. This variant takes
# the whole repo as context and lets pnpm prune the dependency graph instead,
# via --filter "{apps/webhook}...". Same output, fewer moving parts.
#
# Build (from the repo root):
#   docker build -f apps/webhook/Dockerfile.olly -t olly-novu-webhook:3.17.0-olly.2 .
#
# Olly source patches. Re-apply each one when moving to a new Novu release:
#
#   1. Provider webhook signatures are verified before an event is trusted
#      (src/webhooks/usecases/webhook/webhook.usecase.ts, the verifySignature
#      call; webhook.command.ts and webhooks.controller.ts pass headers and the
#      raw body through). Upstream community skips this.
#
#   2. Email bounces and complaints are handed to Olly's notifications
#      (ENG-1144), so Novu is the only receiver of the provider's delivery
#      events. After CreateExecutionDetails writes a bounced or complaint
#      execution detail it calls toOllyEmailEvent / forwardOllyEmailEvent
#      (src/webhooks/usecases/execution-details/olly-email-events.ts, and the
#      one call at the end of create-execution-details.usecase.ts execute()).
#      It POSTs JSON to OLLY_EMAIL_EVENTS_URL (notifications
#      /internal/email-events) with X-Internal-Service: OLLY_INTERNAL_SVC_SECRET.
#      Off when OLLY_EMAIL_EVENTS_URL is unset, and skipped for a request no
#      signing key verified (Webhook.signatureChecked): an unverified report
#      is recorded in Novu as upstream does but never reaches Olly. The
#      provider is built from integration.configurations merged under
#      integration.credentials, because Novu's API stores
#      inboundWebhookSigningKey under configurations while the dashboard has
#      stored it under credentials; upstream reads credentials only. A 5xx, a 404 or a network error
#      makes the receiver answer 500 so the provider retries; notifications
#      deduplicates on the provider's event id (svix-id). The container needs
#      the olly_olly network to reach notifications (infra/novu/compose in
#      OllyInsurance/olly).
#      On upgrade: keep the file, re-add the call, and check that
#      CreateExecutionDetailsCommand still carries message, webhook (with
#      headers) and webhookEvent.event (status, externalId, row).

FROM node:22.22.1-alpine3.22 AS build
RUN apk add --no-cache g++ make py3-pip
ENV NX_DAEMON=false
RUN npm --no-update-notifier --no-fund --global install pnpm@11.0.9

WORKDIR /usr/src/app
COPY . .

# Install only the webhook app's dependency closure, not the whole monorepo.
RUN pnpm install --filter "novuhq" --filter "{apps/webhook}..." \
      --frozen-lockfile --unsafe-perm --reporter=silent

RUN NODE_ENV=production pnpm build:webhook

# Upstream also copies scripts/dotenvcreate.mjs alongside the build, but that
# script pulls configuration from AWS Secrets Manager for Novu Cloud. A
# self-hosted deployment takes its environment from compose, so it is dropped
# here along with its entrypoint invocation.
WORKDIR /usr/src/app/apps/webhook
RUN cp src/.example.env dist/.env \
 && cp src/.env.development dist/.env.development \
 && cp src/.env.production dist/.env.production

WORKDIR /usr/src/app
RUN pnpm --filter @novu/webhook deploy --legacy --prod /usr/src/deploy

# ---------- runtime ----------
FROM node:22.22.1-alpine3.22 AS prod
ENV CI=true
RUN npm --no-update-notifier --no-fund --global install pm2@6.0.14 \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

USER 1000
WORKDIR /usr/src/app
COPY --chown=1000:1000 --from=build /usr/src/deploy .
COPY --chown=1000:1000 --from=build /usr/src/app/apps/webhook/dist ./dist

# Upstream uses `-i max`, which forks one process per CPU (16 on our hosts) for
# what is a low-volume receiver. Default to 2 and leave it tunable.
ENTRYPOINT [ "sh", "-c", "pm2-runtime start dist/main.js -i ${WEB_CONCURRENCY:-2}" ]
